  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArcaneKeepers.Tutorial.TutorialDirector
  theme: {fileID: 11400000, guid: e41849e707d89f6488c1db31ba54226b, type: 2}
  onlyFirstTime: 1
